DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# PostGIS (docker compose up -d). Leave unset to fall back to local SQLite.
# Note the postgis:// scheme: it selects Django's PostGIS backend.
DATABASE_URL=postgis://schoolrun:schoolrun@localhost:5432/schoolrun_db

# Leave unset to use the in-memory channel layer (single process, dev only).
REDIS_URL=redis://localhost:6379/0

GOOGLE_MAPS_API_KEY=your-google-maps-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Windows only, once GDAL is installed (e.g. via OSGeo4W):
# GDAL_LIBRARY_PATH=C:\OSGeo4W\bin\gdal309.dll
# GEOS_LIBRARY_PATH=C:\OSGeo4W\bin\geos_c.dll
